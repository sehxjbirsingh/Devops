# Environment Configuration for DevOps Command Center
# Copy this file to .env and adjust variables as needed

# Application Environment (development or production)
APP_ENV=development

# Optional API Key for write/update/delete operations and traffic simulation
# If left empty, API authentication is disabled for local convenience
# In production, set a strong random secret key
API_KEY=

# Optional Token to protect raw /metrics endpoint
# If left empty, /metrics is publicly accessible for local Prometheus
# In production, set a token (pass Authorization: Bearer <METRICS_TOKEN> in Prometheus)
METRICS_TOKEN=

# SQLite Database Storage Path
DATABASE_PATH=./data/devops.db

# Server Host and Port
PORT=8000
HOST=0.0.0.0
